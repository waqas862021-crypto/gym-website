# Copy this file to frontend/.env.local and fill in real values.
# Never commit the actual .env.local file.

# --- Supabase (create a free project at supabase.com) ---
# Safe to expose to the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser or a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Integration providers ---
# "mock" = no real charge/email/AI call is made; used through Phase 11.
# Swap to a real provider name once real accounts/keys exist (see the build plan).
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=mock
AI_PROVIDER=mock

# Real AI provider key (only read when AI_PROVIDER is not "mock")
AI_API_KEY=
