# Copy this file to frontend/.env.local and fill in real values.
# Never commit the actual .env.local file.

# --- Database (Vercel Postgres) ---
# POSTGRES_URL and friends are set automatically once you link a Postgres
# database to this project in the Vercel dashboard (Storage tab) — you
# generally don't need to set these by hand, they appear in Vercel's
# Environment Variables automatically. Only needed locally if you ever run
# this outside Vercel.
# POSTGRES_URL=

# --- Auth ---
# A random secret used to sign session tokens. Generate one yourself (e.g.
# `openssl rand -base64 32`) and set it in Vercel's Environment Variables —
# this one is NOT set automatically.
AUTH_SECRET=

# --- Integration providers ---
# "mock" = no real charge/email/AI call is made; used through Phase 11.
# Swap to a real provider name once real accounts/keys exist (see the build plan).
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=mock
AI_PROVIDER=mock

# Real AI provider key (only read when AI_PROVIDER is not "mock")
AI_API_KEY=
